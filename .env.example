# ================================================================
# БАЗА ДАННЫХ
# ================================================================
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=product_assistant

# DATABASE_URL внутри Docker — имя сервиса 'db'
# При локальном запуске замените 'db' на 'localhost'
DATABASE_URL=postgresql://postgres:your_secure_password@db:5432/product_assistant

# ================================================================
# AI МОДЕЛЬ (Qwen через внутренний API)
# ================================================================
QWEN_API_URL=https://model-2.ai-api.vsk.ru/v1/completions
QWEN_MODEL_NAME=Qwen3.6-35B-A3B-NVFP4
QWEN_MAX_TOKENS=100000

# Температура генерации (0.0 — детерминированно, 1.0 — творчески)
AI_TEMPERATURE=0.3

# ================================================================
# TELEGRAM БОТ
# ================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ================================================================
# ПАРСИНГ САЙТА ПРОДУКТОВ
# ================================================================
# Базовый URL раздела с продуктами
PRODUCTS_WEBSITE_URL=https://products.vsk.ru

# Тип парсера:
#   auto        — автоопределение по структуре сайта
#   playwright  — SPA / JS-рендеринг (React, Vue, Next.js)
#   selenium    — SPA через Selenium + Keycloak авторизация
#   local_files — чтение PDF/DOCX/PPTX из локальной директории
SCRAPER_TYPE=selenium

# Для SCRAPER_TYPE=local_files — путь к директории с документами
# LOCAL_FILES_DIR=/app/documents

# Selenium Grid URL (только для SCRAPER_TYPE=selenium)
# selenium запускается с network_mode:host — доступен по имени/IP сервера
# Пример: http://em-ta-prod.vsk.ru:4444
SELENIUM_URL=http://YOUR_SERVER_HOSTNAME:4444

# Авторизация Keycloak (если сайт продуктов закрыт за SSO)
SCRAPER_USERNAME=your_login
SCRAPER_PASSWORD=your_password

# Явные пути продуктов через запятую (если не задано — обнаруживаются автоматически)
PRODUCT_PATHS=/products/DIR_CASCO_1/passport/69732348598f6a5425aaef3d,/products/DIR_CASCO_1/passport/697320d920ce24170f04654c,/products/DIR_CASCO_1/passport/69731cab3965be392fd73daa,/products/DIR_CASCO_1/passport/697319833965be392fd73da9,/products/DIR_CASCO_1/passport/6973127220ce24170f04654a,/products/DIR_CASCO_1/passport/6973139920ce24170f04654b,/products/DIR_CASCO_1/passport/6970acf020ce24170f046549
